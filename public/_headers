# Cloudflare Pages response headers. Without this file every file is served with max-age=0, so browsers re-check
# each picture and sound with the server on every visit.

# Build output: file names change whenever the content does, so browsers can keep them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Learning media keeps its file name when replaced, so cache it for a week and refresh in the background after that.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/audio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
